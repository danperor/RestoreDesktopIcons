<Window x:Class="RestoreDesktopIcons.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RestoreDesktopIcons.ViewModels"
        Title="Windows 桌面图标守护程序 (DesktopIconTool)"
        Icon="/app.png"
        Height="520" Width="820"
        MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- ========== 现代按钮基础模板 ========== -->
        <Style x:Key="ModernButtonBase" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0.5" BlurRadius="2" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作: 保存 -->
        <Style x:Key="SaveButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22C55E" Offset="0"/>
                        <GradientStop Color="#16A34A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- 主操作: 恢复 -->
        <Style x:Key="RestoreButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- 次级工具按钮 -->
        <Style x:Key="ToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonBase}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <!-- ========== 数据表头 ========== -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
        </Style>

        <!-- ========== 数据行：重点强化选中状态 ========== -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <!-- 重点：选中行高亮 — 左侧蓝色指示条 + 深蓝背景 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="#1E3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========== 数据单元格 ========== -->
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#1E3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 竖分隔线 -->
        <Style x:Key="ToolbarDivider" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="8,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><!-- 0: 工具栏 -->
            <RowDefinition Height="Auto"/><!-- 1: 状态指示栏 -->
            <RowDefinition Height="Auto"/><!-- 2: 警报横幅 -->
            <RowDefinition Height="Auto"/><!-- 3: 吸附横幅 -->
            <RowDefinition Height="*"/>  <!-- 4: 快照列表 -->
            <RowDefinition Height="Auto"/><!-- 5: 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ====== 操作工具栏 ====== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- 第一组：核心操作 -->
                    <Button Content="💾 保存当前布局" Style="{StaticResource SaveButtonStyle}" 
                            Command="{Binding SaveLayoutCommand}" 
                            ToolTip="抓取当前桌面所有图标坐标并保存为快照&#x0a;（含桌面原生截图，支持多屏独立存档）"
                            Margin="0,0,6,0"/>
                    <Button Content="🔄 恢复选中布局" Style="{StaticResource RestoreButtonStyle}" 
                            Command="{Binding RestoreLayoutCommand}" 
                            ToolTip="将桌面图标恢复至选中快照&#x0a;（恢复前自动创建现场安全备份）"
                            Margin="0,0,4,0"/>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <!-- 第二组：快照管理 -->
                    <Button Content="🖼 查看截图" Style="{StaticResource ToolButtonStyle}" 
                            Command="{Binding ViewScreenshotCommand}" 
                            ToolTip="查看选中快照的桌面截图" Margin="0,0,4,0"/>
                    <Button Content="✏ 重命名" Style="{StaticResource ToolButtonStyle}" 
                            Command="{Binding RenameLayoutCommand}" 
                            ToolTip="修改快照名称" Margin="0,0,4,0"/>
                    <Button Content="🗑 删除" Style="{StaticResource ToolButtonStyle}" 
                            Command="{Binding DeleteLayoutCommand}" 
                            ToolTip="删除所选快照及其截图文件" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="📋 日志" Style="{StaticResource ToolButtonStyle}" 
                            Command="{Binding ViewLogFileCommand}" 
                            ToolTip="查看程序运行日志 (app.log)" Margin="0,0,4,0"/>
                    <Button Content="⟳" Style="{StaticResource ToolButtonStyle}" FontSize="15" Padding="10,5"
                            Command="{Binding RefreshStatusCommand}" 
                            ToolTip="刷新自动排列检测与屏幕拓扑状态"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ====== 系统状态指示栏 ====== -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,7" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- 自动排列状态 -->
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#22C55E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoArrangeActive}" Value="True">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontFamily="Microsoft YaHei UI">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="自动排列: 关闭"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoArrangeActive}" Value="True">
                                        <Setter Property="Text" Value="⚠ 自动排列: 开启"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 桌面图标可见性 -->
                    <Border Width="1" Background="#E2E8F0" Margin="16,2" Height="16" VerticalAlignment="Center"/>
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#22C55E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AreIconsVisible}" Value="False">
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontFamily="Microsoft YaHei UI">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="桌面图标: 显示"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AreIconsVisible}" Value="False">
                                        <Setter Property="Text" Value="桌面图标: 已隐藏"/>
                                        <Setter Property="Foreground" Value="#D97706"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 屏幕拓扑 -->
                    <Border Width="1" Background="#E2E8F0" Margin="16,2" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="🖥" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TopologySummary}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <CheckBox Content="⏱ 自动隐藏图标"
                              IsChecked="{Binding IsAutoHideEnabled}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              FontSize="12" Foreground="#64748B" FontFamily="Microsoft YaHei UI"
                              ToolTip="【开启】：用户空闲时自动隐藏桌面图标，点击桌面空白处立即恢复；&#x0a;可在系统右下角托盘图标右键菜单中设置等待时间或快速切换。"/>
                    <CheckBox Content="📸 原生穿透截屏"
                              IsChecked="{Binding UseRealDesktopCapture}"
                              VerticalAlignment="Center"
                              FontSize="12" Foreground="#64748B" FontFamily="Microsoft YaHei UI"
                              ToolTip="【勾选】：直接向桌面底层图层请求原生渲染 (推荐)&#x0a;【取消】：使用后台全息重绘引擎 (备用方案)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ====== 自动排列警告横幅 ====== -->
        <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="14,9" Margin="0,0,0,6"
                Visibility="{Binding IsAutoArrangeActive, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="⚠️  当前桌面已勾选【自动排列图标】！在此模式下恢复操作会被系统强制重排覆盖。请先在桌面右键 → 查看 → 取消勾选【自动排列图标】。"
                       Foreground="#92400E" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" FontFamily="Microsoft YaHei UI"/>
        </Border>

        <!-- ====== 引力吸附通知横幅 ====== -->
        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14,9" Margin="0,0,0,6"
                Visibility="{Binding HasClampedNotice, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="{Binding ClampedNotice}" Foreground="#1E40AF" FontWeight="SemiBold" FontSize="12" FontFamily="Microsoft YaHei UI"/>
        </Border>

        <!-- ====== 布局快照列表 ====== -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Snapshots}"
                      SelectedItem="{Binding SelectedSnapshot}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      AlternationCount="2"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      CanUserResizeRows="False"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🔄  恢复此布局" Command="{Binding RestoreLayoutCommand}" FontWeight="Bold"/>
                        <Separator/>
                        <MenuItem Header="🖼  查看桌面截图 (并排全景)" Command="{Binding ViewScreenshotCommand}"/>
                        <MenuItem Header="🖥  查看主屏截图 (DISPLAY1)" Command="{Binding ViewSpecificScreenshotCommand}" CommandParameter="DISPLAY1"/>
                        <MenuItem Header="🖥  查看副屏截图 (DISPLAY2)" Command="{Binding ViewSpecificScreenshotCommand}" CommandParameter="DISPLAY2"/>
                        <MenuItem Header="📂  打开截图存放目录" Command="{Binding OpenScreenshotFolderCommand}"/>
                        <MenuItem Header="📋  查看运行日志" Command="{Binding ViewLogFileCommand}"/>
                        <Separator/>
                        <MenuItem Header="✏  重命名" Command="{Binding RenameLayoutCommand}"/>
                        <MenuItem Header="🗑  删除快照" Command="{Binding DeleteLayoutCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="快照名称" Binding="{Binding Name}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="屏幕拓扑" Binding="{Binding TopologySummary}" Width="1.4*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="图标数" Binding="{Binding IconCount}" Width="58">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="截图预览" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="查看截图" 
                                        Padding="8,3" 
                                        FontSize="11"
                                        FontFamily="Microsoft YaHei UI"
                                        Cursor="Hand"
                                        Visibility="{Binding HasScreenshot, Converter={StaticResource BoolToVisConverter}}"
                                        Command="{Binding DataContext.ViewScreenshotCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        ToolTip="打开全尺寸桌面截图">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#F1F5F9" 
                                                    BorderBrush="#CBD5E1" 
                                                    BorderThickness="1"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="保存时间" Binding="{Binding FormattedTime}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ====== 底部状态栏 ====== -->
        <Border Grid.Row="5" Margin="0,8,0,0" Padding="4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI">
                    <Run Text="共"/>
                    <Run Text="{Binding Snapshots.Count, Mode=OneWay}"/>
                    <Run Text="个快照"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" 
                           Foreground="#475569" FontSize="11.5" FontFamily="Microsoft YaHei UI"
                           VerticalAlignment="Center" TextAlignment="Right" 
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
